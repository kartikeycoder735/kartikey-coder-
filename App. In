# ---------- Razorpay (asli payment) ----------
# Keys set karein:  RAZORPAY_KEY_ID  aur  RAZORPAY_KEY_SECRET  (nahi hon to demo payment chalta hai)
import os, hmac, hashlib, json, base64, urllib.request

RZP_ID = os.environ.get("RAZORPAY_KEY_ID")
RZP_SECRET = os.environ.get("RAZORPAY_KEY_SECRET")
ADMIN_PASSWORD = os.environ.get("ADMIN_PASSWORD", "admin123")
COMMISSION = 0.15  # platform ka hissa


def rzp_checkout(b):
    auth = base64.b64encode(f"{RZP_ID}:{RZP_SECRET}".encode()).decode()
    req = urllib.request.Request(
        "https://api.razorpay.com/v1/orders",
        data=json.dumps({"amount": b["amount"] * 100, "currency": "INR", "receipt": f"bk{b['id']}"}).encode(),
        headers={"Content-Type": "application/json", "Authorization": "Basic " + auth})
    order = json.load(urllib.request.urlopen(req, timeout=15))
    db().execute("UPDATE bookings SET order_id=? WHERE id=?", (order["id"], b["id"]))
    db().commit()
    return page("""<div class="card"><h1>Payment</h1><p>{{ b.pname }} · {{ b.slot|when }}</p><h2>₹{{ b.amount }}</h2>
<button class="btn" id="pay">₹{{ b.amount }} pay karein</button></div>
<form id="f" method="post" action="/pay/{{ b.id }}/verify"><input type="hidden" name="razorpay_payment_id">
<input type="hidden" name="razorpay_order_id"><input type="hidden" name="razorpay_signature"></form>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>document.getElementById('pay').onclick=function(){new Razorpay({key:{{ key|tojson }},amount:{{ b.amount*100 }},
currency:'INR',name:'PanditSeva',order_id:{{ oid|tojson }},handler:function(r){var f=document.getElementById('f');
for(var k in r){if(f[k])f[k].value=r[k]}f.submit()}}).open()}</script>""", b=b, key=RZP_ID, oid=order["id"])


@app.route("/pay/<int:bid>/verify", methods=["POST"])
def verify(bid):
    if (r := login_required()):
        return r
    if not RZP_SECRET:
        abort(404)
    b = my_booking(bid)
    pid, oid, sig = (request.form.get(k, "") for k in ("razorpay_payment_id", "razorpay_order_id", "razorpay_signature"))
    good = hmac.new(RZP_SECRET.encode(), f"{oid}|{pid}".encode(), hashlib.sha256).hexdigest()
    if oid != b["order_id"] or not hmac.compare_digest(good, sig):
        abort(400, "Payment verify nahi hua. Paisa kata ho to support se sampark karein.")
    db().execute("UPDATE bookings SET status='paid' WHERE id=?", (bid,))
    db().commit()
    return redirect(url_for("booking", bid=bid))


