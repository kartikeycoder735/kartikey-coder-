"""
PanditSeva - pandit appointment app (Flask + SQLite)
Chalane ke liye:  pip install flask   ->   python app.py   ->   http://localhost:5000
Payment abhi DEMO hai (/pay). Asli payment ke liye Razorpay Checkout yahin jodein.
Audio/Video call Jitsi Meet ke room link se hoti hai (free). Baad mein Agora/Zego laga sakte hain.
"""
import sqlite3, secrets, datetime
from flask import Flask, request, redirect, session, render_template_string, g, abort, url_for

app = Flask(__name__)
app.secret_key = "badal-dein-production-mein"
DB = "pandit.db"
TIMES = ("10:00", "12:00", "16:00", "18:00")


def db():
    if "db" not in g:
        g.db = sqlite3.connect(DB)
        g.db.row_factory = sqlite3.Row
    return g.db


@app.teardown_appcontext
def close_db(_):
    d = g.pop("db", None)
    if d:
        d.close()


def init_db():
    c = sqlite3.connect(DB)
    c.executescript("""
    CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY, name TEXT, phone TEXT UNIQUE);
    CREATE TABLE IF NOT EXISTS pandits(id INTEGER PRIMARY KEY, name TEXT, city TEXT, languages TEXT,
        specialty TEXT, experience INT, fees INT, rating REAL, about TEXT);
    CREATE TABLE IF NOT EXISTS bookings(id INTEGER PRIMARY KEY, user_id INT, pandit_id INT, slot TEXT,
        mode TEXT, amount INT, status TEXT, room TEXT);
    """)
    for tbl, col in (("bookings", "order_id TEXT"), ("pandits", "phone TEXT"), ("pandits", "pin TEXT")):
        try:
            c.execute(f"ALTER TABLE {tbl} ADD COLUMN {col}")
        except sqlite3.OperationalError:
            pass
    if not c.execute("SELECT 1 FROM pandits").fetchone():
        c.executemany(
            "INSERT INTO pandits(name,city,languages,specialty,experience,fees,rating,about) VALUES(?,?,?,?,?,?,?,?)",
            [
                ("Pt. Ramesh Sharma", "Varanasi", "Hindi, Sanskrit", "Griha Pravesh, Satyanarayan Katha", 18, 1100, 4.8,
                 "Kashi ke parampara se shiksha. Ghar ki pooja aur katha ka lamba anubhav."),
                ("Pt. Suresh Joshi", "Ujjain", "Hindi, Marathi", "Kundli, Vivah Muhurat", 12, 801, 4.6,
                 "Kundli milan aur vivah muhurat mein visheshagya."),
                ("Acharya Madhav Iyer", "Chennai", "Tamil, Sanskrit, English", "Havan, Shanti Pooja", 25, 1500, 4.9,
                 "Vedic havan aur shanti pooja, videsh mein rehne wale parivaron ke liye bhi."),
                ("Pt. Anil Mishra", "Prayagraj", "Hindi", "Vastu, Kundli Milan", 9, 501, 4.5,
                 "Vastu salah aur kundli milan, seedhi aur saaf bhasha mein."),
            ])
    c.execute("UPDATE pandits SET phone='900000000'||id, pin='1234' WHERE phone IS NULL")
    c.commit()
    c.close()


def free_slots(pid):
    taken = {r["slot"] for r in db().execute(
        "SELECT slot FROM bookings WHERE pandit_id=? AND status IN ('pending','paid')", (pid,))}
    today = datetime.date.today()
    out = []
    for i in range(1, 4):
        day = today + datetime.timedelta(days=i)
        out += [f"{day.isoformat()} {t}" for t in TIMES if f"{day.isoformat()} {t}" not in taken]
    return out


@app.template_filter("when")
def when(s):
    return datetime.datetime.strptime(s, "%Y-%m-%d %H:%M").strftime("%d %b, %I:%M %p")


@app.context_processor
def inject_user():
    uid = session.get("uid")
    u = db().execute("SELECT * FROM users WHERE id=?", (uid,)).fetchone() if uid else None
    return {"user": u}


