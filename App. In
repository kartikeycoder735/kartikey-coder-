@app.route("/login", methods=["GET", "POST"])
def login():
    nxt = request.values.get("next", "/")
    if request.method == "POST":
        name, phone = request.form["name"].strip(), request.form["phone"].strip()
        if not name or not phone.isdigit() or len(phone) != 10:
            return page("<p>Naam aur 10 anko ka mobile number sahi bharein. <a href='/login'>Wapas</a></p>")
        c = db()
        c.execute("INSERT OR IGNORE INTO users(name,phone) VALUES(?,?)", (name, phone))
        c.commit()
        session["uid"] = c.execute("SELECT id FROM users WHERE phone=?", (phone,)).fetchone()["id"]
        return redirect(nxt if nxt.startswith("/") else "/")
    return page("""<form class="card" method="post"><h1>Login</h1><input type="hidden" name="next" value="{{ nxt }}">
