@app.route("/admin/add", methods=["POST"])
def admin_add():
    session.get("admin") or abort(403)
    f = request.form
    if not (f["experience"].isdigit() and f["fees"].isdigit() and f["phone"].isdigit() and len(f["phone"]) == 10):
        abort(400, "Anubhav, fees aur 10 anko ka mobile number sahi bharein.")
    db().execute("INSERT INTO pandits(name,city,languages,specialty,experience,fees,rating,about,phone,pin) VALUES(?,?,?,?,?,?,?,?,?,?)",
                 (f["name"], f["city"], f["languages"], f["specialty"], int(f["experience"]), int(f["fees"]), 4.5,
                  "Naya pandit, jaldi hi vistrit parichay jodein.", f["phone"], f["pin"]))
    db().commit()
    return redirect("/admin")


@app.route("/admin/cancel/<int:bid>", methods=["POST"])
def admin_cancel(bid):
    session.get("admin") or abort(403)
    db().execute("UPDATE bookings SET status='refunded' WHERE id=? AND status IN ('paid','pending')", (bid,))
    db().commit()
    return redirect("/admin")


