@app.route("/book/<int:pid>", methods=["POST"])
def book(pid):
    if (r := login_required()):
        return r
    p = db().execute("SELECT * FROM pandits WHERE id=?", (pid,)).fetchone() or abort(404)
    slot, mode = request.form.get("slot"), request.form.get("mode", "video")
    if slot not in free_slots(pid) or mode not in ("video", "audio"):
        abort(400, "Ye slot ab khaali nahi hai. Doosra slot chunein.")
    cur = db().execute(
        "INSERT INTO bookings(user_id,pandit_id,slot,mode,amount,status,room) VALUES(?,?,?,?,?,?,?)",
        (session["uid"], pid, slot, mode, p["fees"], "pending", "PanditSeva-" + secrets.token_hex(8)))
    db().commit()
    return redirect(url_for("pay", bid=cur.lastrowid))


def my_booking(bid):
    b = db().execute(
        "SELECT b.*, p.name AS pname FROM bookings b JOIN pandits p ON p.id=b.pandit_id WHERE b.id=? AND b.user_id=?",
        (bid, session.get("uid"))).fetchone()
    return b or abort(404)


@app.route("/pay/<int:bid>", methods=["GET", "POST"])
def pay(bid):
    if (r := login_required()):
        return r
    b = my_booking(bid)
    if b["status"] != "pending":
        return redirect(url_for("booking", bid=bid))
    if RZP_ID and RZP_SECRET:
        return rzp_checkout(b)
    if request.method == "POST":  # Demo mode: Razorpay keys set nahi hain
        db().execute("UPDATE bookings SET status='paid' WHERE id=?", (bid,))
        db().commit()
        return redirect(url_for("booking", bid=bid))
    return page("""
<div class="card"><h1>Payment</h1><p>{{ b.pname }} · {{ b.slot|when }} · {{ 'Video' if b.mode=='video' else 'Audio' }} call</p>
<h2>₹{{ b.amount }}</h2><p class="mute">Ye demo payment hai, asli paisa nahi katega.</p>
<form method="post"><button class="btn">₹{{ b.amount }} pay karein (demo)</button></form></div>""", b=b)


